{
  "name": "noch-gut-bot",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./lib/index.ts"
  },
  "scripts": {
    "dev": "tsx watch ./run.ts",
    "book:generate": "tsx ./scripts/book/generate-book-text.mts --italic",
    "post": "tsx --env-file=.env ./scripts/post.mts",
    "post:mastodon": "tsx --env-file=.env ./scripts/post.mts mastodon",
    "post:bluesky": "tsx --env-file=.env ./scripts/post.mts bluesky",
    "preview": "tsx ./scripts/preview.mts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.10.5",
    "@types/papaparse": "^5.3.15",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "prettier": "^3.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.48.1"
  },
  "dependencies": {
    "@atproto/api": "^0.13.25",
    "masto": "^7.1.0",
    "papaparse": "^5.5.2"
  }
}
