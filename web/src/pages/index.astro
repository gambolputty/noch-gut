---
import { EntryList } from "../components/EntryList";
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Noch gut</title>
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: 16px;
        line-height: 1.6;
        color: #222;
        background: #fff;
        padding: 2rem 1rem;
        max-width: 40rem;
        margin: 0 auto;
      }

      h1 {
        font-size: 1rem;
        font-weight: normal;
        margin-bottom: 2rem;
        color: #666;
      }

      .protocol-day {
        margin-bottom: 2.5rem;
      }

      .day-header {
        font-size: 1rem;
        font-weight: bold;
        margin-bottom: 1rem;
        color: #222;
      }

      .entries {
        list-style: none;
      }

      .entry {
        margin-bottom: 0.5rem;
      }

      .entry-featured {
        margin-top: 2rem;
        margin-bottom: 2rem;
      }

      .entry-image {
        display: block;
        max-width: 100%;
        height: auto;
        margin-bottom: 0.5rem;
      }

      .more {
        color: #999;
        text-align: center;
        padding: 2rem 0;
      }

      .infinite-scroll-component {
        overflow: visible !important;
      }
    </style>
  </head>
  <body>
    <h1>Noch gut</h1>
    <EntryList client:load />
  </body>
</html>
