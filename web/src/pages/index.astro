---
import { EntryList } from "../components/EntryList";
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Noch gut</title>
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: 16px;
        line-height: 1.6;
        color: #222;
        background: #fff;
        padding: 2rem 1rem;
        max-width: 40rem;
        margin: 0 auto;
      }

      a {
        color: #06c;
      }

      a:hover {
        text-decoration: underline;
      }

      h1 {
        font-size: 1.5rem;
        font-weight: bold;
        margin-bottom: 0.5rem;
        color: #222;
      }

      .intro {
        color: #666;
        margin-bottom: 2rem;
      }

      .intro-text {
        display: inline;
      }

      .more-toggle {
        color: #06c;
        cursor: pointer;
        border: none;
        background: none;
        font: inherit;
        padding: 0;
      }

      .more-toggle:hover {
        text-decoration: underline;
      }

      .more-content {
        margin-top: 1rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid #ddd;
      }

      .more-content.hidden {
        display: none;
      }

      .more-content p {
        margin-bottom: 0.5rem;
      }

      .more-content .links {
        display: flex;
        gap: 1rem;
      }

      .nav {
        display: flex;
        justify-content: flex-end;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
      }

      .nav-link {
        color: #666;
        text-decoration: none;
        font-size: 0.875rem;
        cursor: pointer;
        border: none;
        background: none;
        font-family: inherit;
      }

      .nav-link:hover {
        color: #222;
      }

      .protocol-day {
        margin-bottom: 2.5rem;
      }

      .day-header {
        font-size: 1rem;
        font-weight: bold;
        margin-bottom: 1rem;
        color: #222;
      }

      .entries {
        list-style: none;
      }

      .entry {
        margin-bottom: 0.5rem;
      }

      .entry-featured {
        margin-top: 2rem;
        margin-bottom: 2rem;
      }

      .entry-image-wrapper {
        margin-bottom: 0.5rem;
      }

      .entry-image-wrapper.loading {
        max-width: 280px;
        aspect-ratio: 3 / 4;
        background: linear-gradient(
          90deg,
          #f0f0f0 25%,
          #e0e0e0 50%,
          #f0f0f0 75%
        );
        background-size: 200% 100%;
        animation: skeleton-pulse 1.5s ease-in-out infinite;
      }

      .entry-image {
        display: block;
        max-width: 100%;
        height: auto;
        opacity: 0;
      }

      .entry-image.loaded {
        opacity: 1;
        transition: opacity 0.3s ease;
      }

      @keyframes skeleton-pulse {
        0% {
          background-position: 200% 0;
        }
        100% {
          background-position: -200% 0;
        }
      }

      .more {
        color: #999;
        text-align: center;
        padding: 2rem 0;
      }

      .infinite-scroll-component {
        overflow: visible !important;
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <button class="nav-link" id="regenerate">Neu generieren</button>
    </nav>

    <h1>Noch gut</h1>
    <div class="intro">
      <span class="intro-text">Protokoll gegessener Lebensmittel, die ihr Mindesthaltbarkeitsdatum überschritten haben.</span>
      <button class="more-toggle" id="more-toggle">Mehr</button>
      <div class="more-content hidden" id="more-content">
        <p>Die Produktdaten stammen von <a href="https://world.openfoodfacts.org/" target="_blank" rel="noopener">Open Food Facts</a>, einer offenen Lebensmitteldatenbank.</p>
        <p class="links">
          <a href="https://bsky.app/profile/noch-gut.bsky.social" target="_blank" rel="noopener">Bluesky</a>
          <a href="https://mas.to/@noch_gut" target="_blank" rel="noopener">Mastodon</a>
          <a href="https://github.com/gambolputty/noch-gut" target="_blank" rel="noopener">GitHub</a>
        </p>
        <p><a href="https://ggor.de" target="_blank" rel="noopener">Gregor Weichbrodt</a>, 2026</p>
      </div>
    </div>
    <EntryList client:load />

    <script>
      document.getElementById('regenerate')?.addEventListener('click', () => {
        location.reload();
      });

      document.getElementById('more-toggle')?.addEventListener('click', (e) => {
        const content = document.getElementById('more-content');
        const button = e.target as HTMLButtonElement;
        content?.classList.toggle('hidden');
        button.textContent = content?.classList.contains('hidden') ? 'Mehr' : 'Weniger';
      });
    </script>
  </body>
</html>
